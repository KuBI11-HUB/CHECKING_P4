# GRANTED web root (Phase 7). Needs AllowOverride All (the XAMPP default); verify with the checks in docs/DEPLOY_CHECKLIST.md.
Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)(\.(sql|md|json|lock|log|bak|old|orig|swp|ps1|bat|cmd|sh|ini|yml|yaml|dist|example|zip|gz|tar)|\.local\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [F,L]
    RewriteRule ^(config|includes|vendor|docs|uploads|sql|database|backup|backups)(/|$) - [F,L]
</IfModule>